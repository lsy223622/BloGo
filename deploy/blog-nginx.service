[Unit]
Description=BloGo non-root static HTTP server
After=network.target

[Service]
Type=simple
User=www-data
Group=blog-web
ExecStart=/usr/sbin/nginx -c /etc/blog/nginx.conf -g "daemon off;"
Restart=on-failure
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadOnlyPaths=/srv/blog/releases /srv/blog-stats-public /etc/blog /etc/nginx
InaccessiblePaths=/srv/blog/source /var/lib/blog-stats /srv/blog-stats-private

[Install]
WantedBy=multi-user.target
