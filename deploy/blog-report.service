[Unit]
Description=BloGo public statistics and private HTML report
After=local-fs.target
ConditionPathExists=/var/lib/blog-stats/database/stats.db
ConditionPathExists=/srv/blog/current/meta/manifest.json

[Service]
Type=oneshot
User=blog-report
Group=blog-reports
SupplementaryGroups=blog-meta blog-web
ExecStart=/usr/local/bin/blog report --config /etc/blog/stats.yaml
UMask=0027
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/blog-stats/database /srv/blog-stats-public /srv/blog-stats-private
ReadOnlyPaths=/var/lib/blog-stats/database/stats.db /srv/blog/current/meta /etc/blog
InaccessiblePaths=/srv/blog/source /var/lib/blog-stats/visitor.key
RestrictAddressFamilies=AF_UNIX
